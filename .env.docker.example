# Salin ke .env lalu isi. Dipakai oleh docker-compose.yml
# APP_KEY: jalankan `docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"`
APP_KEY=
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
SITE_URL=http://localhost:3000
DB_PASSWORD=pkkmb
MINIO_ROOT_USER=pkkmb
MINIO_ROOT_PASSWORD=pkkmb-secret
# true = isi data dummy & akun demo saat start (MATIKAN di produksi)
SEED_DEMO=true
DEMO_MODE=true
ANTHROPIC_API_KEY=
