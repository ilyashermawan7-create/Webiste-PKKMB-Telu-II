# URL API Laravel (dipakai server Next.js; di Docker gunakan http://backend:8000/api/v1)
API_URL=http://localhost:8000/api/v1
# URL publik situs (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Rahasia penanda tangan cookie role (min. 32 karakter acak) — WAJIB diganti di produksi
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
# Tampilkan tombol akun demo di halaman login (set false di produksi)
NEXT_PUBLIC_DEMO_MODE=true
