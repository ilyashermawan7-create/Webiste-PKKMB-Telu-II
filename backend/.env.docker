# Konfigurasi backend untuk Docker (rahasia diinjeksi dari .env root lewat docker-compose)
APP_NAME="PKKMB Telkom University API"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=pkkmb
DB_USERNAME=pkkmb
REDIS_CLIENT=phpredis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
UPLOADS_DISK=s3
UPLOADS_PUBLIC_DISK=s3_public
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=pkkmb-private
AWS_PUBLIC_BUCKET=pkkmb-public
AWS_URL=http://localhost:9000/pkkmb-public
AWS_USE_PATH_STYLE_ENDPOINT=true
MAIL_MAILER=log
MAIL_FROM_ADDRESS="pkkmb@telkomuniversity.ac.id"
MAIL_FROM_NAME="PKKMB Telkom University"
ANTHROPIC_MODEL=claude-opus-5-5
SSO_DRIVER=mock
SSE_MAX_SECONDS=55
TRUSTED_PROXIES=*
SEED_MABA=280
