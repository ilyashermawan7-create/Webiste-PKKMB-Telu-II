APP_NAME="PKKMB Telkom University API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pkkmb
DB_USERNAME=pkkmb
DB_PASSWORD=pkkmb

# Redis: cache, rate limit, queue
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# Penyimpanan file: local/public untuk dev, s3 untuk MinIO / Cloudflare R2
UPLOADS_DISK=local
UPLOADS_PUBLIC_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=pkkmb
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Email (Resend via SMTP / SMTP kampus)
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="pkkmb@telkomuniversity.ac.id"
MAIL_FROM_NAME="PKKMB Telkom University"

# Asisten PKKMB (opsional). Kosongkan untuk mode FAQ saja.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# SSO kampus: mock | (adapter lain)
SSO_DRIVER=mock

# Proxy tepercaya (Nginx / Next.js BFF) agar IP klien benar untuk rate limit
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Durasi koneksi SSE (detik). 0 untuk `php artisan serve`, 55 untuk PHP-FPM/Octane
SSE_MAX_SECONDS=0

# Jumlah maba dummy saat seeding
SEED_MABA=280
